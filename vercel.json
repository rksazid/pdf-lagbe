{
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm ci",
  "outputDirectory": ".",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "{src/**,tests/**,.puppeteer/**}"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "env": {
    "PUPPETEER_SKIP_DOWNLOAD": "true"
  }
}
