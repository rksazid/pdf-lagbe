{
  "version": 2,
  "buildCommand": "rm -rf dist && npm run build",
  "installCommand": "PUPPETEER_SKIP_DOWNLOAD=true npm ci",
  "functions": {
    "api/index.js": {
      "memory": 1024,
      "maxDuration": 60,
      "excludeFiles": "src/**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api" }
  ],
  "env": {
    "PUPPETEER_SKIP_DOWNLOAD": "true"
  }
}
